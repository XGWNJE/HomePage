---
import MeteorShower from '../components/MeteorShower.astro';
import ParthenonColumns from '../components/ParthenonColumns.astro';
import UniversalPageList from '../components/UniversalPageList.astro';
import TerminalQuote from '../components/TerminalQuote.astro';
import { BILIBILI_URL, GITHUB_URL, SITE_TITLE } from '../consts';
import { DEFAULT_UI_LANG, getUiText } from '../data/i18n';
import { visualAssets } from '../data/visualAssets';
import SiteLayout from '../layouts/SiteLayout.astro';

const BASE = import.meta.env.BASE_URL;
const T = getUiText(DEFAULT_UI_LANG);

---

<SiteLayout title={`${SITE_TITLE} - Research, Engineering & Technical Notes`} description="A personal blog about research, engineering workflows, and reproducible long-form writing.涵盖编程、技术笔记和工程实践。">
	<Fragment slot="background">
		<ParthenonColumns />
		<MeteorShower density={0.45} heightVh={46} />
	</Fragment>
		<main class="page-shell page-fade-in py-10 md:py-14" transition:name="page-main" transition:animate="fade">
			<div class="space-y-6">
				<section class="home-hero hero-enter group relative overflow-hidden rounded-2xl border border-zinc-200 bg-[#151415] dark:border-zinc-700" tabindex="0" aria-label="XGWNJE 首页介绍">
					<div class="h-[18rem] w-full overflow-hidden md:h-[clamp(22rem,42vw,32rem)]">
						<img
							src={visualAssets.sandrone.reserve.diverseHeroes.sunlitRoseGarden}
							alt="桑多涅在日光温室中整理白玫瑰与机械园艺工具"
							width="1920"
							height="1080"
							loading="eager"
							fetchpriority="high"
							decoding="async"
							class="hero-kenburns h-full w-full object-cover object-center"
						/>
					</div>
					<div class="home-hero-shade absolute inset-0 bg-gradient-to-t from-black/90 via-black/45 to-black/10"></div>
					<div class="home-hero-overlay absolute inset-0 grid grid-cols-1 content-end gap-5 p-5 text-white md:grid-cols-[minmax(0,1fr)_minmax(17rem,24rem)] md:items-end md:p-8 lg:p-10">
						<div class="max-w-[40rem]">
						<h1 class="brand-wordmark flex flex-wrap items-center gap-x-2.5 gap-y-1" transition:name="page-title" transition:animate="fade">
							<span class="text-[2.2rem] leading-none text-white drop-shadow-lg md:text-[3.4rem]">
								XGWNJE
							</span>
							<span class="text-[2.2rem] italic leading-none text-zinc-200 drop-shadow-lg md:text-[3.4rem]">
								Index
							</span>
						</h1>
						<p class="mt-2 max-w-xl font-sans text-sm leading-6 text-zinc-200 md:mt-3 md:text-[15px] md:leading-7">
							<span data-i18n="home.subtitle">{T['home.subtitle']}</span>
						</p>
						<div class="mt-2 flex flex-wrap items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.16em] text-zinc-200 md:mt-3">
							<span class="apple-meta-pill border-white/25 bg-black/35">
								<span class="apple-meta-pill-label" data-i18n="home.pill.research">{T['home.pill.research']}</span>
							</span>
							<span class="apple-meta-pill border-white/25 bg-black/35">
								<span class="apple-meta-pill-label" data-i18n="home.pill.engineering">{T['home.pill.engineering']}</span>
							</span>
							<span class="apple-meta-pill border-white/25 bg-black/35">
								<span class="apple-meta-pill-label" data-i18n="home.pill.notes">{T['home.pill.notes']}</span>
							</span>
						</div>
						<div class="mt-3 flex items-center gap-2">
							<a
								href={GITHUB_URL}
								target="_blank"
								rel="noreferrer"
								class="icon-button inline-flex h-10 w-10 items-center justify-center rounded-xl border border-white/25 bg-black/35 text-zinc-100 transition-colors hover:border-white/60 hover:bg-black/55 hover:text-white"
								aria-label="GitHub"
							>
								<svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true">
									<path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.523 2 12 2z" />
								</svg>
								<span class="sr-only">GitHub</span>
							</a>
							<a
								href={BILIBILI_URL}
								target="_blank"
								rel="noreferrer"
								class="icon-button inline-flex h-10 w-10 items-center justify-center rounded-xl border border-white/25 bg-black/35 text-zinc-100 transition-colors hover:border-white/60 hover:bg-black/55 hover:text-white"
								aria-label="Bilibili"
							>
								<svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true">
									<path d="M7.4 2.8a1 1 0 0 1 1.4 0L12 6l3.2-3.2a1 1 0 1 1 1.4 1.4L14.5 6.3h3.8A3.7 3.7 0 0 1 22 10v8.3A3.7 3.7 0 0 1 18.3 22H5.7A3.7 3.7 0 0 1 2 18.3V10a3.7 3.7 0 0 1 3.7-3.7h3.8L7.4 4.2a1 1 0 0 1 0-1.4ZM5.7 8.3A1.7 1.7 0 0 0 4 10v8.3c0 .9.8 1.7 1.7 1.7h12.6c.9 0 1.7-.8 1.7-1.7V10c0-.9-.8-1.7-1.7-1.7H5.7Zm1.8 3a1 1 0 0 1 1 1v3.4a1 1 0 1 1-2 0v-3.4a1 1 0 0 1 1-1Zm9 0a1 1 0 0 1 1 1v3.4a1 1 0 1 1-2 0v-3.4a1 1 0 0 1 1-1Z" />
								</svg>
								<span class="sr-only">Bilibili</span>
							</a>
						</div>
						</div>

						<div class="hidden w-full max-w-sm justify-self-end md:block">
						<TerminalQuote />
						</div>
					</div>
				</section>
			</div>

			<section class="mt-6 md:mt-8">
				<div class="mb-4 flex items-center justify-between" data-reveal>
					<h2 class="text-xl font-semibold tracking-tight" data-i18n="home.latestPosts">{T['home.latestPosts']}</h2>
					<a
						href={`${BASE}blog/`}
						class="apple-float-chip inline-flex items-center gap-1.5 rounded-xl border border-zinc-300/90 bg-zinc-50/96 px-3 py-1.5 text-sm font-medium text-zinc-700 no-underline dark:border-zinc-700/90 dark:bg-zinc-900/96 dark:text-zinc-300"
					>
						<span class="apple-float-label">
							<span data-i18n="home.viewAll">{T['home.viewAll']}</span>
							<svg viewBox="0 0 20 20" class="h-4 w-4 opacity-75" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
								<path d="M4.75 10h10.5" stroke-linecap="round" />
								<path d="M10.75 5.5 15.25 10l-4.5 4.5" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</span>
					</a>
				</div>
				<div class="md:[&_[data-universal-pages-list]]:grid-cols-2">
					<UniversalPageList limit={6} />
				</div>
			</section>
		</main>
</SiteLayout>

<style>
	.home-hero-shade,
	.home-hero-overlay {
		transition: opacity 220ms ease, transform 260ms ease;
	}

	@media (hover: hover) and (pointer: fine) and (min-width: 768px) {
		.home-hero-shade,
		.home-hero-overlay {
			opacity: 0;
		}

		.home-hero-overlay {
			pointer-events: none;
			transform: translateY(10px);
		}

		.home-hero:hover .home-hero-shade,
		.home-hero:hover .home-hero-overlay,
		.home-hero:focus-visible .home-hero-shade,
		.home-hero:focus-visible .home-hero-overlay,
		.home-hero:focus-within .home-hero-shade,
		.home-hero:focus-within .home-hero-overlay {
			opacity: 1;
		}

		.home-hero:hover .home-hero-overlay,
		.home-hero:focus-visible .home-hero-overlay,
		.home-hero:focus-within .home-hero-overlay {
			pointer-events: auto;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.home-hero-shade,
		.home-hero-overlay {
			transition: none;
		}
	}
</style>
