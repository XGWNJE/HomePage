---
import MeteorShower from '../../components/MeteorShower.astro';
import PageHeading from '../../components/PageHeading.astro';
import UniversalPageList from '../../components/UniversalPageList.astro';
import { SITE_TITLE } from '../../consts';
import { DEFAULT_UI_LANG, getUiText } from '../../data/i18n';
import SiteLayout from '../../layouts/SiteLayout.astro';

const T = getUiText(DEFAULT_UI_LANG);
---

<SiteLayout title={`内容 | ${SITE_TITLE}`} description="所有已审核并发布的通用 HTML 内容页。">
	<Fragment slot="background"><MeteorShower density={0.4} heightVh={40} /></Fragment>
	<main class="page-shell page-fade-in py-10 md:py-14" transition:name="page-main" transition:animate="fade">
		<section class="mx-auto max-w-4xl">
			<PageHeading eyebrow={T['blog.eyebrow']} eyebrowKey="blog.eyebrow" title="内容页" subtitle="所有内容统一作为自由 HTML 页面管理，审核通过后立即显示。" />
			<div class="mt-8 min-h-[24rem]"><UniversalPageList emptyText="暂无已发布内容页。" /></div>
		</section>
	</main>
</SiteLayout>
